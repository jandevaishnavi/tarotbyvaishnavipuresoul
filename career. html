  border-bottom:1px solid rgba(255,255,255,.4);
  position:sticky;
  top:0;
  z-index:100;
}

.logo{
  color:white;
  font-size:clamp(1.4rem,4vw,2.2rem);
  font-weight:bold;
  text-shadow:0 3px 8px rgba(100,40,0,.25);
}

.logo span{
  display:block;
  color:skyblue;
  font-size:.55em;
  letter-spacing:4px;
  margin-top:4px;
}

.menu-button{
  border:none;
  padding:12px 20px;
  border-radius:30px;
  background:white;
  color:#df5b00;
  font-weight:bold;
  cursor:pointer;
  box-shadow:0 5px 15px rgba(120,50,0,.2);
}

/* HOME */

.hero{
  min-height:calc(100vh - 85px);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:40px 20px;
}

.hero h1{
  color:white;
  font-size:clamp(2.3rem,8vw,5rem);
  text-shadow:0 4px 12px rgba(120,40,0,.25);
}

.hero h1 span{
  color:skyblue;
}

.hero p{
  max-width:650px;
  margin:20px auto 30px;
  line-height:1.7;
  font-size:clamp(1rem,2.5vw,1.2rem);
  color:#783600;
}

.start-button{
  border:none;
  padding:15px 30px;
  border-radius:40px;
  background:white;
  color:#df5b00;
  font-weight:bold;
  cursor:pointer;
  font-size:1rem;
  box-shadow:0 8px 25px rgba(120,50,0,.2);
  transition:.3s;
}

.start-button:hover{
  transform:scale(1.05);
}

/* TAROT */

#careerSection{
  display:none;
  padding:70px 4% 100px;
  text-align:center;
}

#careerSection.show{
  display:block;
  animation:appear .7s ease;
}

@keyframes appear{
  from{
    opacity:0;
    transform:translateY(30px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.section-title{
  color:white;
  font-size:clamp(2rem,6vw,3.5rem);
  text-shadow:0 3px 10px rgba(120,40,0,.2);
}

.section-subtitle{
  margin:12px 0 45px;
  color:#7d3500;
}

/* GRID */

.card-container{
  max-width:1250px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(125px,1fr));
  gap:25px;
  justify-items:center;
}

/* CARD */

.tarot-wrapper{
  width:125px;
  height:180px;
  perspective:1000px;
  cursor:pointer;
}

.tarot-card{
  width:100%;
  height:100%;
  position:relative;
  transform-style:preserve-3d;
  transition:transform .8s cubic-bezier(.2,.7,.2,1);
}

.tarot-wrapper.flipped .tarot-card{
  transform:rotateY(180deg);
}

.card-face{
  position:absolute;
  width:100%;
  height:100%;
  backface-visibility:hidden;
  border-radius:20px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:14px;
  box-shadow:0 10px 25px rgba(140,55,0,.25);
  border:2px solid rgba(255,255,255,.7);
}

/* FRONT */

.card-front{
  background:linear-gradient(145deg,#fff,#fff0df);
}

.card-number{
  width:68px;
  height:68px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(145deg,#ff7800,#ffb45c);
  color:white;
  font-size:1.6rem;
  font-weight:bold;
  box-shadow:0 5px 12px rgba(180,70,0,.2);
}

.card-name{
  color:#d95700;
  font-size:.78rem;
  font-weight:bold;
  margin-top:12px;
}

.choose{
  color:#9a4a12;
  font-size:.65rem;
  margin-top:5px;
}

/* BACK */

.card-back{
  transform:rotateY(180deg);
  background:linear-gradient(145deg,#ff7200,#ffb347);
  color:white;
  text-align:center;
}

.card-back .symbol{
  font-size:1.5rem;
  margin-bottom:7px;
}

.card-back h3{
  font-size:.85rem;
  margin-bottom:8px;
}

.card-back p{
  font-size:.67rem;
  line-height:1.4;
}

/* FOOTER */

footer{
  text-align:center;
  padding:25px;
  color:#853b00;
  font-size:.85rem;
}

/* MOBILE */

@media(max-width:600px){

  header{
    padding:15px 4%;
  }

  .logo{
    font-size:1.35rem;
  }

  .menu-button{
    padding:9px 12px;
    font-size:.72rem;
  }

  .hero h1{
    font-size:2.5rem;
  }

  .card-container{
    grid-template-columns:repeat(2,125px);
    justify-content:center;
    gap:20px;
  }

  #careerSection{
    padding:50px 10px 70px;
  }
}

@media(max-width:350px){

  .card-container{
    grid-template-columns:repeat(2,105px);
  }

  .tarot-wrapper{
    width:105px;
    height:160px;
  }

  .card-number{
    width:58px;
    height:58px;
    font-size:1.4rem;
  }

  .card-name{
    font-size:.7rem;
  }

  .card-back p{
    font-size:.59rem;
  }
}
</style>
</head>

